{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/test-report.schema.json",
  "title": "Test Report Schema",
  "description": "Schema for JSON test reports generated by pytest-json-report",
  "type": "object",
  "required": ["created", "duration", "summary", "tests"],
  "properties": {
    "created": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when test suite started",
      "example": "2025-11-03T14:30:00Z"
    },
    "duration": {
      "type": "number",
      "minimum": 0,
      "maximum": 300,
      "description": "Total test suite execution time in seconds",
      "example": 285.4
    },
    "summary": {
      "type": "object",
      "required": ["total", "passed", "failed", "skipped"],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of tests executed",
          "example": 54
        },
        "passed": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of tests that passed",
          "example": 52
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of tests that failed",
          "example": 2
        },
        "skipped": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of tests that were skipped",
          "example": 0
        }
      }
    },
    "tests": {
      "type": "array",
      "description": "Detailed results for each test case",
      "items": {
        "$ref": "#/definitions/TestResult"
      }
    },
    "metadata": {
      "type": "object",
      "description": "Additional test suite metadata",
      "properties": {
        "cost_tracking": {
          "$ref": "#/definitions/CostTracking"
        }
      }
    }
  },
  "definitions": {
    "TestResult": {
      "type": "object",
      "required": ["nodeid", "outcome", "duration"],
      "properties": {
        "nodeid": {
          "type": "string",
          "description": "pytest test identifier",
          "example": "tests/test_pipeline.py::test_extraction_accuracy[paper_001]"
        },
        "outcome": {
          "type": "string",
          "enum": ["passed", "failed", "skipped"],
          "description": "Test execution outcome",
          "example": "passed"
        },
        "duration": {
          "type": "number",
          "minimum": 0,
          "description": "Test execution time in seconds",
          "example": 8.234
        },
        "call": {
          "type": "object",
          "properties": {
            "longrepr": {
              "type": ["string", "null"],
              "description": "Detailed failure message if test failed",
              "example": "AssertionError: Technique 'BERT' not found"
            },
            "outcome": {
              "type": "string",
              "enum": ["passed", "failed", "skipped"],
              "example": "passed"
            }
          }
        },
        "setup": {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "enum": ["passed", "failed"],
              "example": "passed"
            },
            "duration": {
              "type": "number",
              "description": "Setup phase duration in seconds",
              "example": 0.001
            }
          }
        },
        "teardown": {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "enum": ["passed", "failed"],
              "example": "passed"
            },
            "duration": {
              "type": "number",
              "description": "Teardown phase duration in seconds",
              "example": 0.001
            }
          }
        }
      }
    },
    "CostTracking": {
      "type": "object",
      "required": [
        "suite_run_id",
        "total_api_calls",
        "input_tokens",
        "output_tokens",
        "model_used",
        "estimated_cost_usd"
      ],
      "properties": {
        "suite_run_id": {
          "type": "string",
          "description": "Unique identifier for this test suite run",
          "example": "report_20251103_143000"
        },
        "total_api_calls": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of OpenAI API requests made during tests",
          "example": 8
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Total input tokens consumed",
          "example": 2400
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Total output tokens consumed",
          "example": 400
        },
        "model_used": {
          "type": "string",
          "description": "OpenAI model identifier",
          "example": "gpt-4o-mini"
        },
        "estimated_cost_usd": {
          "type": "number",
          "minimum": 0,
          "description": "Estimated cost in USD",
          "example": 0.0006
        }
      }
    }
  }
}

