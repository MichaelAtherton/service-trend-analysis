# AI Technique Extraction Service - Environment Variables

# ========================================
# Embedding Server Configuration
# ========================================
EMBEDDING_SERVER_URL=http://localhost:8765
EMBEDDING_CLIENT_ID=extraction-service
EMBEDDING_CLIENT_SECRET=your-secret-key-here

# ========================================
# OpenAI API Configuration
# ========================================
OPENAI_API_KEY=sk-your-openai-api-key-here

# ========================================
# Authentication & Security
# ========================================
# Comma-separated list of allowed API keys for server-to-server auth
ALLOWED_API_KEYS=key1,key2,key3

# ========================================
# Rate Limiting
# ========================================
# Global rate limit (batches per hour)
DEFAULT_RATE_LIMIT=100

# ========================================
# Application Configuration
# ========================================
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Minimum confidence threshold for technique extraction (0.0-1.0)
CONFIDENCE_THRESHOLD=0.6

# Server port (Railway will override with dynamic PORT)
PORT=8001

# ========================================
# Railway Production Variables
# ========================================
# These are set automatically by Railway, no need to configure locally
# RAILWAY_ENVIRONMENT=production
# PORT=<dynamic>
